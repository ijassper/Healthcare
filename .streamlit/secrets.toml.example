# Streamlit Secrets Template File
# 이 파일을 동일한 위치에 `secrets.toml` 이름으로 복사한 후 실제 API 키 및 토큰으로 변경하여 사용하세요.
# 주의: secrets.toml 파일은 절대 Git 저장소에 커밋하지 마세요 (.gitignore에 추가 필수).

# Google Gemini API Key
GOOGLE_API_KEY = "your-google-generative-ai-api-key"

# Notion API Integration Token
NOTION_TOKEN = "ntn_your_notion_integration_token"

# Notion Database ID
NOTION_DATABASE_ID = "your_notion_database_id_32_chars"
